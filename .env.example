# Environment for the Oracle database and the terminal-launched Deep Sec app.
# Copy to .env, fill the values, and load it before starting Docker Compose:
#   set -a; source .env; set +a

# Micronaut profile used when launching the application from the terminal.
MICRONAUT_ENVIRONMENTS=oracle-deepsec

# Oracle SYS/SYSTEM/PDBADMIN password. Compose exposes this to the database
# only as the Docker secret /run/secrets/oracle_pwd.
ORACLE_DB_PASSWORD="[strong-database-password]"

# Microsoft Entra application used by Micronaut OAuth2 and Oracle JDBC.
PETCLINIC_TENANT_ID="[tenant-id]"
PETCLINIC_CLIENT_ID="[application-client-id]"
PETCLINIC_CLIENT_SECRET="[client-secret]"
# Application ID URI and delegated scope exposed by the PetClinic app for
# browser login. With the default Entra URI, this becomes
# api://<PETCLINIC_CLIENT_ID>/access_as_user.
PETCLINIC_APP_ID_URI="api://[application-client-id]"
PETCLINIC_USER_SCOPE="${PETCLINIC_APP_ID_URI}/access_as_user"
# Optional local-demo fixture values. They identify sample owner rows only; they
# are not used to define or grant Oracle data roles.
DEEPSEC_TEST_USER_EMAIL="user@***.onmicrosoft.com"
DEEPSEC_ELEVATED_USER_EMAIL="user@email.com"
# Register this exact URI as a Web redirect URI on the PetClinic application.
# Micronaut builds it from the active server port and the entraid client name.
# http://localhost:8080/oauth/callback/entraid

# Scope for the database resource application.
DB_APP_ID_URI="api://[database-application-id]"
DB_APP_ID="[database-application-client-id]"
PETCLINIC_SCOPE="${DB_APP_ID_URI}/.default"
# Database scope that the PetClinic app must be authorized to request in Entra. It is used
# by the JDBC provider's client-credentials flow, not by the browser login.
PETCLINIC_DELEGATED_SCOPE="${DB_APP_ID_URI}/sessions:scope:connect"
# Secret used to sign Micronaut's local authentication cookie (at least 32 bytes).
JWT_GENERATOR_SIGNATURE_SECRET="[random-local-cookie-signing-secret]"

# Oracle TCPS connection used by the terminal-launched application.
DEEPSEC_DB_HOST=localhost
DEEPSEC_DB_PORT=2484
DEEPSEC_DB_SERVICE=FREEPDB1
DEEPSEC_DB_TLS_SERVER_CERT_DN=CN=localhost

# Run `sh docker/oracle/export-wallet.sh` first, then replace these paths
# with the absolute wallet paths printed by that command.
ORACLE_WALLET_DIR="/absolute/path/to/micronaut-petclinic/docker/oracle/wallet"
ORACLE_WALLET_TRUSTSTORE="/absolute/path/to/micronaut-petclinic/docker/oracle/wallet/cwallet.sso"
